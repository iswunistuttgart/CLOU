# Local development defaults
# Backend API: http://localhost:8000
# Embedding service: http://localhost:8001 when exposed separately, or http://embedding-service:8000 inside Docker

# Public app URLs
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local
PROJECT_NAME=Semantic Search Database App

# API / observability
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173

# Postgres
# Host access outside Docker: localhost:5432
# Service-to-service access in Docker: db:5432
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Docker image tags
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_EMBEDDING_CPU=embedding-service:latest_cpu
TAG=latest

# Embedding service
EMBEDDING_SERVICE_URL=http://embedding-service:8000
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto
EMBEDDING_ON_WRITE=false

# Background embedding catch-up
EMBEDDING_PERIODIC_CATCHUP_ENABLED=false
EMBEDDING_CATCHUP_RUN_IN_API=false
EMBEDDING_MAX_INFLIGHT=2
EMBEDDING_CATCHUP_INTERVAL_SEC=5
EMBEDDING_CATCHUP_BATCH_SIZE=50
EMBEDDING_WAIT_FOR_IMPORT_IDLE=true
EMBEDDING_IMPORT_IDLE_STABLE_CHECKS=3
EMBEDDING_IMPORT_IDLE_CHECK_SEC=5

# Semantic search tuning
NODE_SEARCH_LIMIT_DEFAULT=10
NODE_SEARCH_LIMIT_MAX=50
NODE_SEARCH_RRF_K_DEFAULT=60
NODE_SEARCH_RRF_K_MIN=1
NODE_SEARCH_RRF_K_MAX=1000
NODE_SEARCH_LEX_MULTIPLIER=10
NODE_SEARCH_DENSE_MULTIPLIER=10
NODE_SEARCH_WEIGHT_LEXICAL=1.0
NODE_SEARCH_WEIGHT_DENSE=1.4
NODE_SEARCH_WEIGHT_TRIGRAM=0.8
NODE_SEARCH_TRIGRAM_MULTIPLIER=10
NODE_SEARCH_TRIGRAM_THRESHOLD=0.2
NODE_SEARCH_HIGH_TRIGRAM_THRESHOLD=0.85
NODE_SEARCH_ENABLE_TRIGRAM_FALLBACK=true
NODE_SEARCH_ENABLE_DENSE_FALLBACK=true
NODE_SEARCH_ENSURE_DB_ARTIFACTS_ON_STARTUP=true
NODE_SEARCH_EXACT_NAME_BONUS=1.0
NODE_SEARCH_HIGH_TRIGRAM_BONUS=0.2
NODE_SEARCH_DISPLAY_NAME_SIMILARITY_BONUS=1.0